{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "RetroXmsg.*/*.csproj" ],
          "exclude": [ "**/tests/**", "**/obj/**", "**/bin/**" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "allowCompilationErrors": false,
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "*.md", "toc.yml" ] }
    ],
    "resource": [ { "files": [ "images/**" ] } ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "RetroXmsg",
      "_appTitle": "RetroXmsg API reference",
      "_appLogoPath": "images/RetroXmsg.png",
      "_appFaviconPath": "images/RetroXmsg.png",
      "_appFooter": "Copyright (c) 1985-2026 Ronny Hansen - MIT License - RetroCore Labs - <a href=\"https://github.com/RetroCoreLabs/RetroXmsg\">GitHub</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/RetroCoreLabs/RetroXmsg",
        "branch": "main"
      }
    },
    "template": [ "default", "modern", "template" ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
