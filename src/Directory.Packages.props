<Project>
  <!-- Central package versions. Generated by rename.py from the highest version seen per package; edit by hand afterwards. -->
  <PropertyGroup>
    <!-- The app repos reference RetroIO as 0.1.0-local.* so a fresh publish-local stamp is always
         picked up. Central Package Management REJECTS a floating PackageVersion unless this is on
         (NU1011), so the local-feed workflow does not build without it. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg.Api" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg.Diagnostics" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg.Hdlc" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg.Live" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg.Servers" Version="0.1.0-local.*" />
    <PackageVersion Include="RetroIO.Protocols.Xmsg.Sync" Version="0.1.0-local.*" />
  </ItemGroup>
</Project>
